{
  "$defs": {
    "NoteBullet": {
      "additionalProperties": false,
      "properties": {
        "board_block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Board Block Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "figure_block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the one diagram block worth showing with this note, or null. Never a blank or repeated diagram",
          "title": "Figure Block Id"
        },
        "kind": {
          "default": "point",
          "description": "point: ordinary note; definition: defines a term; example: a worked example or exercise; result: a key formula, rule or theorem; remark: an important intuition or warning",
          "enum": [
            "point",
            "definition",
            "example",
            "result",
            "remark"
          ],
          "title": "Kind",
          "type": "string"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latex"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short box title for definition/example/result/remark (e.g. the term defined), else null",
          "title": "Title"
        },
        "transcript_ranges": {
          "items": {
            "$ref": "#/$defs/TimeRange"
          },
          "title": "Transcript Ranges",
          "type": "array"
        }
      },
      "required": [
        "text",
        "latex",
        "board_block_ids",
        "transcript_ranges",
        "confidence"
      ],
      "title": "NoteBullet",
      "type": "object"
    },
    "SaidNotWritten": {
      "additionalProperties": false,
      "properties": {
        "at_s": {
          "minimum": 0,
          "title": "At S",
          "type": "number"
        },
        "text": {
          "description": "Something the lecturer explained out loud that is not on the board",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "at_s"
      ],
      "title": "SaidNotWritten",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bullets": {
      "items": {
        "$ref": "#/$defs/NoteBullet"
      },
      "title": "Bullets",
      "type": "array"
    },
    "end_s": {
      "minimum": 0,
      "title": "End S",
      "type": "number"
    },
    "heading": {
      "title": "Heading",
      "type": "string"
    },
    "said_not_written": {
      "items": {
        "$ref": "#/$defs/SaidNotWritten"
      },
      "title": "Said Not Written",
      "type": "array"
    },
    "start_s": {
      "minimum": 0,
      "title": "Start S",
      "type": "number"
    }
  },
  "required": [
    "heading",
    "start_s",
    "end_s",
    "bullets",
    "said_not_written"
  ],
  "title": "SectionNotes",
  "type": "object"
}
