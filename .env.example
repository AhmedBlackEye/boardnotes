# Copy to .env (never commit .env). Everything works offline with these defaults.

# Postgres. Local: docker compose (make db). Demo: Supabase project > Settings > Database > connection string.
DATABASE_URL=postgresql://boardnotes:boardnotes@localhost:5433/boardnotes

# fake = replay recorded responses from fixtures/llm (no keys). live = real API calls.
LLM_MODE=fake
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Speech-to-text: fixture | fal | elevenlabs. Unset: fixture when LLM_MODE=fake, elevenlabs when live.
# TRANSCRIBER=fal
FAL_API_KEY=

# Long random string in any shared or deployed environment. The API refuses to start without one in live mode or with
# DEMO_LOGIN=false; left empty for a local demo, a random one is made at startup (sessions end on restart).
SESSION_SECRET=
# Demo login lets anyone pick a seeded user, lecturer included: set false for anything public.
DEMO_LOGIN=true
# Force the cookie's Secure flag (e.g. behind a TLS-terminating proxy). Unset: follows the request scheme.
# COOKIE_SECURE=true

# Web app -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGINS=http://localhost:3000
