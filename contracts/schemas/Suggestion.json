      "enum": [
        "open",
        "approved",
        "rejected"
      ],
      "title": "SuggestionStatus",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "agrees",
        "disagrees",
        "unclear"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anonymous": {
      "title": "Anonymous",
      "type": "boolean"
    },
    "author_initials": {
      "title": "Author Initials",
      "type": "string"
    },
    "author_name": {
      "title": "Author Name",
      "type": "string"
    },
    "bullet_id": {
      "title": "Bullet Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "flagged": {
      "title": "Flagged",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "proposed_text": {
      "title": "Proposed Text",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SuggestionStatus"
    },
    "upvotes": {
      "title": "Upvotes",
      "type": "integer"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verdict"
