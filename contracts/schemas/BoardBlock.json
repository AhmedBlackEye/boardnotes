{
  "$defs": {
    "BlockType": {
      "enum": [
        "text",
        "math",
        "diagram"
      ],
      "title": "BlockType",
      "type": "string"
    },
    "ChartElement": {
      "additionalProperties": false,
      "description": "One drawable thing in a chart. Generic: works for plots, vectors, geometry, bar charts, timelines.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Text shown next to the element, or null",
          "title": "Label"
        },
        "points": {
          "description": "[[x, y], ...] in data coordinates. line: 2 points it passes through; segment/vector: start and end; polyline: samples along a curve; point/label: 1 point; bar: [[x, height]]",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "type": {
          "enum": [
            "line",
            "segment",
            "polyline",
            "point",
            "vector",
            "bar",
            "label"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "points",
        "label"
      ],
      "title": "ChartElement",
      "type": "object"
    },
    "ChartSpec": {
      "additionalProperties": false,
      "description": "A small, safe chart description our own code renders (never executed as code).",
      "properties": {
        "elements": {
          "items": {
            "$ref": "#/$defs/ChartElement"
          },
          "maxItems": 50,
          "title": "Elements",
          "type": "array"
        },
        "show_axes": {
          "title": "Show Axes",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "x_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "X Label"
        },
        "x_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "X Range",
          "type": "array"
        },
        "y_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y Label"
        },
        "y_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Y Range",
          "type": "array"
        }
      },
      "required": [
        "title",
        "x_label",
        "y_label",
        "x_range",
        "y_range",
        "show_axes",
        "elements"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "DiagramFigure": {
      "additionalProperties": false,
      "description": "What the notes and PDF show for a diagram block. The board crop is always available as the original.",
      "properties": {
        "caption": {
          "title": "Caption",
          "type": "string"
        },
        "chart": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "chart",
            "mermaid",
            "crop"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mermaid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mermaid"
        },
        "redrawn_by_ai": {
          "title": "Redrawn By Ai",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "chart",
        "mermaid",
        "caption",
        "redrawn_by_ai"
      ],
      "title": "DiagramFigure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bbox": {
      "description": "Position within the best frame, normalised 0-1",
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Bbox",
      "type": "array"
    },
    "best_frame_s": {
      "description": "Time of the clearest frame showing it; used for the snapshot crop",
      "minimum": 0,
      "title": "Best Frame S",
      "type": "number"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "figure": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagramFigure"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set for diagram blocks: redrawn chart/Mermaid, or crop"
    },
    "first_seen_s": {
      "description": "When this writing first appeared",
      "minimum": 0,
      "title": "First Seen S",
      "type": "number"
    },
    "id": {
      "description": "Stable id, e.g. 'b_0412'",
      "title": "Id",
      "type": "string"
    },
    "latex": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latex"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/BlockType"
    }
  },
  "required": [
    "id",
    "type",
    "text",
    "latex",
    "confidence",
    "first_seen_s",
    "best_frame_s",
    "bbox"
  ],
  "title": "BoardBlock",
  "type": "object"
}
