    },
    "verdict_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verdict Reason"
    },
    "voted_by_me": {
      "title": "Voted By Me",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "bullet_id",
    "author_name",
    "author_initials",
    "anonymous",
    "proposed_text",
    "created_at",
    "verdict",
    "verdict_reason",
    "flagged",
    "upvotes",
    "voted_by_me",
    "status"
  ],
  "title": "Suggestion",
  "type": "object"
}
